# 独立的飞书企业自建应用（长连接，无需公网 Webhook）；仅填新应用的凭据。
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
# 只允许一个私聊用户的 open_id（ou_...）；先由该用户发送 /start 绑定。
ALLOWED_FEISHU_OPEN_ID=

# 北京时间每天 09:00；补发窗口配置需结合实际调度代码验证，不能保证断线后必补发。
DAILY_SEND_TIME=09:00
TIMEZONE=Asia/Shanghai
DAILY_CATCHUP_MINUTES=30

# 默认使用第三方 OpenAI 兼容 API；可选 codex（需要单独安装和授权）。
AI_PROVIDER=api
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180

# 已选择的第三方兼容 API 地址；确认服务商支持的模型后再填写 NAN_MODEL，新密钥仅写入私有配置。
# API 调用会外发学习画像、文章内容及问题，并可能按量收费；上线前确认费率和数据政策。
NAN_BASE_URL=https://meta-api.vip/v1
NAN_API_KEY=
NAN_MODEL=
API_DAILY_MAX_CALLS=30
API_MAX_OUTPUT_TOKENS=900
API_TIMEOUT_SECONDS=60

# 可选：英文逗号分隔。留空使用内置文章来源。
# RSS_FEEDS=https://news.mit.edu/rss/topic/artificial-intelligence2,https://huggingface.co/blog/feed.xml
RSS_FEEDS=
ARTICLE_MAX_CHARS=18000
# 可选 HTTP 代理，英文逗号分隔；留空表示不指定代理。Linux 不应照搬 Windows 本机 7890 等端口。
PROXY_URLS=

# 不填写时使用项目目录下的 data/；systemd 服务固定设置 DATA_DIR=/var/lib/ai-learning-bot。
# DATA_DIR=/var/lib/ai-learning-bot
